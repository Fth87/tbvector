{$APP_DOMAIN} {
	@root path /
	header @root {
		Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		Pragma "no-cache"
	}

	# Backend lives in the tbvector-server repo, joined via the tbvector-edge network.
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		encode gzip zstd
		try_files {path} /200.html
		file_server
	}
}
